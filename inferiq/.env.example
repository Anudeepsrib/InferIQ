# InferIQ Environment Configuration Example
# Copy to .env and adjust for your environment. Never commit .env or .env.local

# Environment
INFERIQ_ENV=development

# Paths
INFERIQ_CONFIG_DIR=configs
INFERIQ_RESULTS_DIR=results

# Gateway
INFERIQ_GATEWAY_HOST=0.0.0.0
INFERIQ_GATEWAY_PORT=8000
INFERIQ_GATEWAY_WORKERS=1
INFERIQ_GATEWAY_RELOAD=false
INFERIQ_GATEWAY_LOG_LEVEL=info
INFERIQ_RATE_LIMIT_REQUESTS_PER_MINUTE=120
INFERIQ_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Demo / Development mode (prevents loading real models on CPU machines)
INFERIQ_SKIP_MODEL_LOAD=true
INFERIQ_DEMO_MODE=true

# GPU / Profiling (enable only when NVIDIA GPU + drivers present)
INFERIQ_ENABLE_GPU_PROFILING=false
CUDA_VISIBLE_DEVICES=0

# MLflow (optional)
INFERIQ_ENABLE_MLFLOW=false

# Logging
INFERIQ_LOG_LEVEL=INFO

# Backend specific (for NIM external service)
# NIM_BASE_URL=http://localhost:8001
# NIM_API_KEY=your-ngc-key-here

# Security (optional API key for non-local deployments)
# INFERIQ_API_KEY=change-me-in-production
